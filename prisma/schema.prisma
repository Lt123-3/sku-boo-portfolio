// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SkuLog {
  id              Int      @id @default(autoincrement())
  sku             String
  productId       String
  title           String
  imageUrl        String?
  shopId          String?                              // which store
  skuNumber       String?                              // mirrors SkuIndex.skuNumber
  status          String?  @default("active")          // free | active | reserved | problem | deleted
  warehouseStatus String?                              // reserved for future warehouse features
  problems        String?                              // JSON array
  createdBy       String?                              // userId of who generated it
  createdAt       DateTime @default(now())
}

model SkuIndex {
  id              Int       @id @default(autoincrement())
  shopId          String
  skuNumber       String    @unique
  taken           Boolean   @default(false)
  titleTaken      Boolean   @default(false)
  productId       String?
  title           String?
  status          String    @default("free")           // free | active | reserved | problem | deleted
  problems        String?                              // JSON array e.g. '["no_title","no_pic"]'
  excludedProblems String?                             // JSON array — problems permanently excluded from detection
  warehouseStatus String?                              // reserved for future warehouse features
  reservedAt      DateTime?                            // stores Shopify product.createdAt on sync
  reservedBy      String?                              // access key of the user who reserved it
  syncedAt        DateTime?                            // when we last synced this row
  updatedAt       DateTime  @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
  @@index([shopId, status, skuNumber])
  @@index([warehouseStatus])
}

model AccessKey {
  id        Int      @id @default(autoincrement())
  shopId    String
  userId    String
  username  String   @default("admin")
  role      String   @default("operator")             // viewer | operator | admin
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

model SkuSession {
  id        Int      @id @default(autoincrement())
  sessionId String   @unique
  userId    String
  shopId    String
  username  String
  role      String   @default("operator")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([shopId])
}

model ProductInfo {
  id          Int      @id @default(autoincrement())
  shopId      String
  productId   String   @unique                        // one row per product, upserted on sync
  skuNumber   String?
  title       String?
  vendor      String?
  price       String?                                 // stored as string to preserve decimals
  weight      String?                                 // stored as string with unit
  condition   String?                                 // custom.ebay_condition_id metafield
  inventory   String?                                 // JSON — {locationId: quantity}
  collections String?                                 // JSON array of collection titles
  imageUrl    String?
  imageCount  Int?
  notes       String?                                 // JSON append-only array of {userId, username, text, timestamp}
  updatedAt   DateTime @updatedAt
  syncedAt    DateTime?

  @@index([shopId])
  @@index([skuNumber])
  @@index([shopId, skuNumber])
}

model SkuHistory {
  id         Int      @id @default(autoincrement())
  shopId     String
  productId  String
  skuNumber  String?
  field      String                                   // title | price | vendor | weight | condition | inventory | collections | image
  oldValue   String?
  newValue   String?
  changedAt  DateTime @default(now())
  changedBy  String   @default("system")              // userId or "system"

  @@index([shopId])
  @@index([productId])
  @@index([skuNumber])
  @@index([shopId, productId])
  @@index([field])
  @@index([changedAt])
}

model SyncState {
  id          Int       @id @default(autoincrement())
  shopId      String    @unique
  status      String    @default("idle")
  currentPass Int?
  processed   Int       @default(0)
  total       Int       @default(0)
  cursor      String?                    
  startTime   DateTime?                  
  lastCronRun DateTime?
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  eta         String?
}

model ProblemLog {
  id          Int      @id @default(autoincrement())
  shopId      String
  productId   String
  skuNumber   String?
  action      String   // "detected" | "passed" | "excluded" | "resolved" | "deleted"
  problemType String?  // "no_sku" | "no_title" | "no_title_body" | "no_pic" | "no_prep" | null
  changedBy   String   @default("system")
  note        String?
  createdAt   DateTime @default(now())

  @@index([shopId])
  @@index([productId])
  @@index([skuNumber])
  @@index([shopId, createdAt])
}