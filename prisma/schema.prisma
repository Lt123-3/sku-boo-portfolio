// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SkuLog {
  id        Int      @id @default(autoincrement())
  sku       String
  productId String
  title     String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model SkuIndex {
  id              Int       @id @default(autoincrement())
  shopId          String                                    // which store this SKU belongs to
  skuNumber       String    @unique
  taken           Boolean   @default(false)
  titleTaken      Boolean   @default(false)
  productId       String?
  title           String?
  status          String    @default("free")               // free | active | reserved | problem | deleted
  problems        String?                                  // JSON array e.g. '["no_title","no_pic"]'
  warehouseStatus String?                                  // reserved for future warehouse features
  reservedAt      DateTime?
  reservedBy      String?                                  // access key of the user who reserved it
  updatedAt       DateTime  @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
  @@index([shopId, status, skuNumber])
  @@index([warehouseStatus])
}

model AccessKey {
  id        Int      @id @default(autoincrement())
  shopId    String
  userId    String
  username  String   @default("Larry")                       // e.g. "Luke", "Bob", "Larry"
  role      String   @default("operator")                // viewer | operator | admin
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

