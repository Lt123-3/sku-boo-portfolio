# Copy to .env and fill in real values. .env is gitignored — never commit it.
# The start-skuboo*.sh scripts also export most of these; keep the two in sync.

# ── Shopify app credentials (Partners dashboard → your app → API credentials) ──
SHOPIFY_API_KEY=your-shopify-api-key            # aka client_id (not secret)
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxx   # client secret — keep private
SCOPES=write_products,read_products,read_locations,read_inventory,write_files,read_orders,read_customers,write_inventory
SHOPIFY_APP_URL=https://your-app-domain.com

# The single storefront this deployment serves, e.g. 123your-store.myshopify.com.
# Used by esp-server.js and the ext-api.* routes to resolve the offline session.
SHOP_DOMAIN=your-store.myshopify.com

# ── App session signing ──────────────────────────────────────────────────────
# Any long random string. Rotating it invalidates existing app sessions.
SESSION_SECRET=generate-a-long-random-string

# ── Extension / device API (app/lib/extAuth.server.js, esp-server.js) ─────────
# Bearer token the Chrome extension sends to the ext-api.* routes.
EXTENSION_API_TOKEN=generate-a-long-random-string
# Token the ESP32 shipping-desk device sends to the WebSocket relay.
ESP_API_TOKEN=generate-a-long-random-string
# Optional — WebSocket port for esp-server.js (default 8081).
ESP_WS_PORT=8081

# ── Shippo (app/lib/shippo.server.js) ────────────────────────────────────────
# shippo_test_... for no real charges; shippo_live_... for real rates/labels.
SHIPPO_API_KEY=shippo_test_xxxxxxxxxxxxxxxxxxxx
SHIP_FROM_NAME=Shipping Desk
SHIP_FROM_STREET1=123 Example St
SHIP_FROM_CITY=Anytown
SHIP_FROM_STATE=CA
SHIP_FROM_ZIP=00000

# ── AI settings encryption (app/lib/crypto.server.js) ────────────────────────
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SETTINGS_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=file:./prisma/dev.sqlite
